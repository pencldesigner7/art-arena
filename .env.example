# Art Arena — environment template (copy to .env; NEVER commit real secrets)
# Secrets live HERE only, server-side. Nothing in this file ever reaches the
# frontend bundle — the client only ever sees /api responses.

NODE_ENV=development

# Local PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=art_arena
PGUSER=art_arena_app
PGPASSWORD=change-me

# ── Email delivery (v44) ────────────────────────────────────────────────────
# Provider recommendation: RESEND (transactional, verification/reset codes are
# exactly its use case; single API key; custom domain → SPF/DKIM so mail lands
# in inboxes; free tier ≈100 mails/day — plenty for Art Arena's current scale).
# Postmark stays available as a drop-in alternative via the same seam.
#
# Development (default): simulated inbox, no real mail —
#   read codes via GET /api/dev/outbox?to=<email> (the 📬 buttons in the UI).
MAIL_PROVIDER=dev
MAIL_FROM=Art Arena <noreply@yourdomain.com>

# Production (pick ONE, set the matching secret):
# MAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# MAIL_PROVIDER=postmark
# POSTMARK_SERVER_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# NOTE: MAIL_PROVIDER=dev is hard-blocked when NODE_ENV=production.

# Google sign-in (optional — without these the button stays "coming soon"):
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_REDIRECT_URI=...

# Discord sign-in (optional — without these the button stays "coming soon"):
# Discord Developer Portal → your app → OAuth2 → add the redirect below.
# DISCORD_CLIENT_ID=...
# DISCORD_CLIENT_SECRET=...
# DISCORD_REDIRECT_URI=https://art-arena-galt.onrender.com/api/auth/discord/callback

# ── Twitch Go Live (v62) ────────────────────────────────────────────────────
# Twitch Developer Portal → Your Console → Applications → your app → manage.
# Set the OAuth redirect URL in the portal EXACTLY to TWITCH_REDIRECT_URI.
# Optional: without these the "Go Live via Twitch" UI shows the honest setup
# state (nothing is faked).
# TWITCH_CLIENT_ID=...
# TWITCH_CLIENT_SECRET=...
# TWITCH_REDIRECT_URI=https://art-arena-galt.onrender.com/api/twitch/callback
# TWITCH_EVENTSECRET=... (optional — random string ≥ 10 chars; enables push
#   EventSub live/offline detection. Without it, the built-in Helix polling
#   sweeper still verifies live states genuinely, just not instantly.)
